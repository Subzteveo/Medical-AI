# Example environment for the Medical AI container (chunk C3).
#
# Copy to /etc/medical-ai/medical-ai.env on the host, owned root:root with mode 0600,
# and fill in the empty values there. NEVER commit a filled-in copy: the repository
# hygiene check rejects tracked *.env files and .gitignore blocks deploy/*.env.
#
# Generate each secret on the host, for example:  openssl rand -base64 48
# Secrets must never appear in logs, issues, pull requests, images or CI output.

# --- Required secrets (the server refuses to start without them) -------------------
# HMAC key for trace identifiers; at least 32 bytes.
MEDICAL_AI_TRACE_HMAC_KEY=
# Signing secret for pilot browser sessions; at least 32 bytes.
MEDICAL_AI_PILOT_SESSION_SECRET=

# --- Pilot invitations --------------------------------------------------------------
# Owner-only allowlist file on the mounted state volume (uid/gid 10001, mode 0600).
# Manage it with medical-ai-admin; it is re-read on every request, so issuing or
# revoking an invitation needs no restart. Do not use MEDICAL_AI_PILOT_ACCESS_JSON here.
MEDICAL_AI_PILOT_ACCESS_FILE=/var/lib/medical-ai/pilot_access.json
# Browser cookies are Secure. Leave true; only a local plain-HTTP test may set false.
MEDICAL_AI_PILOT_COOKIE_SECURE=true
MEDICAL_AI_PILOT_SESSION_TTL_SECONDS=28800

# --- Server -------------------------------------------------------------------------
# Host, port and the two SQLite paths are set by the image; override only with cause.
# Exactly one worker until durable revocation (A3) exists; other values are refused.
MEDICAL_AI_WORKERS=1
MEDICAL_AI_LOG_LEVEL=info
# Number of trusted reverse proxies in front of the app (0 until the edge exists).
MEDICAL_AI_TRUSTED_PROXY_COUNT=0

# --- Public-source connectors (optional) ---------------------------------------------
# Contact address and key for NCBI E-utilities; leave empty if unused.
NCBI_EMAIL=
NCBI_API_KEY=
MEDICAL_AI_HTTP_TIMEOUT_SECONDS=20

# --- Rate limits (consumed from chunk C6) ---------------------------------------------
MEDICAL_AI_RATE_LIMIT_ENABLED=true
MEDICAL_AI_RATE_LIMIT_ACCESS_PER_MINUTE=10
MEDICAL_AI_RATE_LIMIT_QUERY_PER_MINUTE=30
